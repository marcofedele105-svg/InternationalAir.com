<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>International Airways | Roblox</title>
    <link rel="stylesheet" href="css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.0/css/all.min.css">
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar" id="navbar">
        <div class="nav-container">
            <div class="nav-logo">
                <span class="logo-icon">✈</span>
                <span class="logo-text">International <span class="highlight">Airways</span></span>
            </div>
            <ul class="nav-links" id="navLinks">
                <li><a href="index.html" class="active">Home</a></li>
                <li><a href="prenotazione.html">Prenota</a></li>
                <li><a href="servizi.html">Servizi</a></li>
                <li><a href="staff.html" class="staff-btn"><i class="fas fa-shield-alt"></i> Staff</a></li>
            </ul>
            <button class="hamburger" id="hamburger" onclick="toggleMenu()">
                <span></span><span></span><span></span>
            </button>
        </div>
    </nav>

    <!-- HERO SECTION -->
    <section class="hero">
        <div class="stars" id="stars"></div>
        <div class="hero-content">
            <div class="badge-top">🎮 ROBLOX OFFICIAL — 2026</div>
            <h1 class="hero-title">
                International<br>
                <span class="gradient-text">Airways</span>
            </h1>
            <p class="hero-sub">Il sistema di trasporto definitivo su Roblox.<br>Prenota il tuo viaggio, scegli il mezzo, vola.</p>
            <div class="hero-buttons">
                <a href="prenotazione.html" class="btn-primary">
                    <i class="fas fa-ticket-alt"></i> Prenota Ora
                </a>
                <a href="servizi.html" class="btn-secondary">
                    <i class="fas fa-list"></i> Vedi Servizi
                </a>
            </div>
        </div>
        <div class="hero-plane">
            <div class="plane-anim">✈</div>
        </div>
        <div class="scroll-down">
            <i class="fas fa-chevron-down"></i>
        </div>
    </section>

    <!-- SERVIZI SECTION -->
    <section class="services-preview" id="services">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">I NOSTRI SERVIZI</span>
                <h2>Come vuoi viaggiare?</h2>
                <p>Scegli il mezzo di trasporto più adatto a te su International Airways</p>
            </div>
            <div class="services-grid">
                <div class="service-card" onclick="window.location='prenotazione.html'">
                    <div class="service-icon bus">🚌</div>
                    <h3>Bus</h3>
                    <p>Tragitti urbani e interurbani, economici e comodi.</p>
                    <div class="card-tag">DISPONIBILE</div>
                </div>
                <div class="service-card" onclick="window.location='prenotazione.html'">
                    <div class="service-icon taxi">🚕</div>
                    <h3>Taxi</h3>
                    <p>Servizio privato porta a porta, veloce e dedicato.</p>
                    <div class="card-tag">DISPONIBILE</div>
                </div>
                <div class="service-card" onclick="window.location='prenotazione.html'">
                    <div class="service-icon treno">🚂</div>
                    <h3>Treno</h3>
                    <p>Connessioni tra città, viaggia in stile e comodità.</p>
                    <div class="card-tag">DISPONIBILE</div>
                </div>
                <div class="service-card" onclick="window.location='prenotazione.html'">
                    <div class="service-icon aereo">✈️</div>
                    <h3>Aereo Privato</h3>
                    <p>Esperienza premium di volo con equipaggio dedicato.</p>
                    <div class="card-tag">DISPONIBILE</div>
                </div>
                <div class="service-card" onclick="window.location='prenotazione.html'">
                    <div class="service-icon nave">🚢</div>
                    <h3>Nave</h3>
                    <p>Traversate marittime panoramiche e rilassanti.</p>
                    <div class="card-tag">DISPONIBILE</div>
                </div>
                <div class="service-card" onclick="window.location='prenotazione.html'">
                    <div class="service-icon elicottero">🚁</div>
                    <h3>Elicottero</h3>
                    <p>Trasferimenti rapidi e panoramici dall'alto.</p>
                    <div class="card-tag">DISPONIBILE</div>
                </div>
            </div>
        </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="how-it-works">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">COME FUNZIONA</span>
                <h2>Prenota in 3 semplici step</h2>
            </div>
            <div class="steps-grid">
                <div class="step">
                    <div class="step-number">01</div>
                    <div class="step-icon"><i class="fas fa-user-circle"></i></div>
                    <h3>Inserisci i tuoi dati</h3>
                    <p>Nome Discord e nome Roblox per identificarti nel sistema.</p>
                </div>
                <div class="step-arrow"><i class="fas fa-arrow-right"></i></div>
                <div class="step">
                    <div class="step-number">02</div>
                    <div class="step-icon"><i class="fas fa-plane"></i></div>
                    <h3>Scegli il mezzo e la tratta</h3>
                    <p>Seleziona il tipo di trasporto e inserisci il codice volo o la destinazione.</p>
                </div>
                <div class="step-arrow"><i class="fas fa-arrow-right"></i></div>
                <div class="step">
                    <div class="step-number">03</div>
                    <div class="step-icon"><i class="fas fa-check-circle"></i></div>
                    <h3>Conferma & Attendi</h3>
                    <p>La tua prenotazione viene registrata. Attendi conferma su Discord.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- DISCORD NOTICE -->
    <section class="discord-notice">
        <div class="container">
            <div class="notice-card">
                <div class="notice-icon"><i class="fab fa-discord"></i></div>
                <div class="notice-text">
                    <h3>Segui il nostro Discord!</h3>
                    <p>Le <strong>destinazioni disponibili</strong>, gli aggiornamenti sui voli e le conferme delle prenotazioni vengono pubblicati esclusivamente sul nostro server Discord. Unisciti per restare aggiornato!</p>
                </div>
                <div class="notice-badge">📢 INFO SU DISCORD</div>
            </div>
        </div>
    </section>

    <!-- CTA SECTION -->
    <section class="cta-section">
        <div class="container">
            <h2>Pronto a partire?</h2>
            <p>Compila il modulo di prenotazione e il nostro staff provvederà a confermare il tuo viaggio.</p>
            <a href="prenotazione.html" class="btn-primary large">
                <i class="fas fa-rocket"></i> Inizia la Prenotazione
            </a>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="container">
            <div class="footer-top">
                <div class="footer-brand">
                    <span class="logo-icon">✈</span>
                    <span class="logo-text">International <span class="highlight">Airways</span></span>
                    <p>Il sistema di trasporto ufficiale su Roblox. Prenotazioni sicure, veloci e monitorate dallo staff.</p>
                </div>
                <div class="footer-links">
                    <h4>Navigazione</h4>
                    <ul>
                        <li><a href="index.html">Home</a></li>
                        <li><a href="prenotazione.html">Prenota</a></li>
                        <li><a href="servizi.html">Servizi</a></li>
                        <li><a href="staff.html">Area Staff</a></li>
                    </ul>
                </div>
                <div class="footer-info">
                    <h4>Info</h4>
                    <ul>
                        <li><i class="fab fa-discord"></i> Discord per destinazioni</li>
                        <li><i class="fab fa-roblox"></i> Solo per Roblox</li>
                        <li><i class="fas fa-shield-alt"></i> Dati protetti</li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>© 2026 International Airways — Roblox Game. Tutti i diritti riservati.</p>
                <p class="footer-disclaimer">Questo sito è un progetto Roblox e non è affiliato con Roblox Corporation.</p>
            </div>
        </div>
    </footer>

    <script src="js/main.js"></script>
</body>
</html>
